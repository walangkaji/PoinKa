{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "format": "prettier --write \"resources/js/**/*.{js,jsx}\" \"resources/css/**/*.css\" vite.config.js package.json .prettierrc",
        "format:check": "prettier --check \"resources/js/**/*.{js,jsx}\" \"resources/css/**/*.css\" vite.config.js package.json .prettierrc"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-react": "^6.1.1",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.9.6",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@inertiajs/react": "^3.7.0",
        "@phosphor-icons/react": "^2.1.10",
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
    }
}
